# --------------------------------------------------------------------
# Email (Configuración CRÍTICA para SendGrid)
# --------------------------------------------------------------------
# NOTA CRÍTICA: Debes reemplazar 'TU_API_KEY_REAL_DE_SENDGRID' con tu clave real.

# Clave usada directamente por la librería de SendGrid en Email.php (Opción A)
SENDGRID_API_KEY = 'TU_API_KEY_REAL_DE_SENDGRID' 

# Configuración de remitente para usar en Email.php
SENDGRID_FROM_EMAIL = 'againsafegas.ascii@gmail.com' 
SENDGRID_FROM_NAME = 'ASG - (Again Safe Gas)' 

# Aunque estos campos de SMTP no se usan si se usa la librería, 
# se mantienen por consistencia y para evitar errores de CodeIgniter.
email.SMTPHost = 'smtp.sendgrid.net'
email.SMTPPort = 587
email.SMTPUser = 'apikey'
email.SMTPPass = 'TU_API_KEY_REAL_DE_SENDGRID'
email.SMTPCrypto = 'tls'

# ... Mantén el resto de tus configuraciones ...
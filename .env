#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Configura el entorno. 'development' muestra errores detallados.
# Cambia a 'production' para ocultar errores detallados en producción.
# Para depuración en Render, 'development' es útil junto con log_errors = On en Dockerfile.
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# Clave de cifrado para CodeIgniter (requerida para sesiones seguras, etc.)
# Genera una clave única y segura para tu aplicación.
# Puedes usar spark key:generate en tu entorno local.
encryption.key =

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Configuración de la base de datos para el entorno 'default'.
# Estos valores anulan la configuración en app/Config/Database.php
# Asegúrate de que estos detalles coincidan exactamente con tu base de datos en Clever Cloud.
database.default.hostname = beqt3q0gyevl7xonxald-mysql.services.clever-cloud.com
database.default.database = beqt3q0gyevl7xonxald
database.default.username = ujlzjpclm80hxedm
database.default.password = 2OJyrxmcM62meKPHo7mu
database.default.DBDriver = MySQLi # Asegúrate de que este driver sea compatible con tu DB (MySQL/MariaDB)
database.default.DBPrefix =
database.default.port = 3306 # Puerto por defecto para MySQL/MariaDB


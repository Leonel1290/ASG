#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# Configuración de la sesión. CodeIgniter 4 usa manejadores de sesión.
# FileHandler es el predeterminado y funciona bien si la carpeta writable tiene permisos.
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null # Si es null, usa writable/sessions. Asegúrate de permisos.
# session.cookieName = 'ci_session'
# session.expiration = 7200 # 2 horas
# session.matchIP = false
# session.timeToUpdate = 300
# session.regenerateDestroy = false

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# EMAIL
#--------------------------------------------------------------------

# Configuración para el envío de emails con SendGrid (o cualquier SMTP)
email.protocol = 'smtp'
email.SMTPHost = 'smtp.sendgrid.net'      # Host de SendGrid
email.SMTPPort = 587                      # Puerto recomendado para SendGrid/TLS
email.SMTPUser = 'apikey'                 # Usuario para SendGrid
email.SMTPPass = 'TU_API_KEY_DE_SENDGRID' # <--- REEMPLAZA ESTO con tu llave secreta
email.SMTPCrypto = 'tls'                  # Encriptación para el puerto 587
email.mailType = 'html' 
email.charset = 'UTF-8'
email.validate = true
email.userAgent = 'CodeIgniter'

# Remitente (usado por PerfilController.php y registerController.php)
# Los controladores leen directamente estas variables
SENDGRID_FROM_EMAIL = 'el.email.verificado@enviador.com' # <--- Email verificado en SendGrid
SENDGRID_FROM_NAME = 'ASG - (Again Safe Gas)'
